diff --git a/test/_db.ts b/test/_db.ts
new file mode 100644
index 0000000..d182651
--- /dev/null
+++ b/test/_db.ts
@@ -0,0 +1,23 @@
+import { connect } from 'node:net';
+import { openDb, type Db } from '../src/db.ts';
+
+// The tests run against the team's database. Without DATABASE_URL (see .env.local) they are skipped.
+const url = process.env.DATABASE_URL;
+export const needsDb = { skip: url ? false : 'needs DATABASE_URL: see .env.local' };
+
+/** Waits for the team's database to answer, then opens the schema the tests use. */
+export async function testDb(): Promise<Db> {
+  const { hostname, port } = new URL(url!);
+  await new Promise<void>((resolve, reject) => {
+    const socket = connect({ host: hostname, port: Number(port || 5432), timeout: 2000 }, () => {
+      socket.end();
+      resolve();
+    });
+    socket.on('error', reject);
+    socket.on('timeout', () => {
+      socket.destroy();
+      reject(new Error('The database did not answer.'));
+    });
+  });
+  return openDb();
+}
