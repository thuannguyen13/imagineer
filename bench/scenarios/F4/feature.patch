diff --git a/test/approval.test.ts b/test/approval.test.ts
new file mode 100644
index 0000000..a4332cd
--- /dev/null
+++ b/test/approval.test.ts
@@ -0,0 +1,67 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { asUser, openDb } from '../src/db.ts';
+import type { User } from '../src/auth.ts';
+import { createExpense, submitExpense } from '../src/expenses.ts';
+import { decideExpense, listQueue } from '../src/approvals.ts';
+
+const alice: User = { id: 1, name: 'Alice', role: 'member', team: 'A' };
+const carol: User = { id: 3, name: 'Carol', role: 'approver', team: 'A' };
+const erin: User = { id: 5, name: 'Erin', role: 'admin', team: 'A' };
+const frank: User = { id: 6, name: 'Frank', role: 'member', team: 'B' };
+
+async function submitted(db: Awaited<ReturnType<typeof openDb>>, owner: User, description: string) {
+  const expense = await createExpense(db, owner, { amount_cents: 1000, description });
+  return submitExpense(db, owner, expense.id);
+}
+
+test('R1: an approver approves or rejects a submitted expense of their team', async () => {
+  const db = await openDb();
+  const one = await submitted(db, alice, 'Train');
+  const two = await submitted(db, alice, 'Taxi');
+  assert.equal((await decideExpense(db, carol, one.id, 'approved')).status, 'approved');
+  assert.equal((await decideExpense(db, carol, two.id, 'rejected')).status, 'rejected');
+});
+
+test('R2: an admin decides expenses of any team', async () => {
+  const db = await openDb();
+  const expense = await submitted(db, frank, 'Flight');
+  assert.equal((await decideExpense(db, erin, expense.id, 'approved')).status, 'approved');
+});
+
+test('R3: members cannot decide, and no one decides their own expense', async () => {
+  const db = await openDb();
+  const expense = await submitted(db, alice, 'Hotel');
+  await assert.rejects(decideExpense(db, alice, expense.id, 'approved'), { status: 403 });
+  const own = await submitted(db, carol, 'Own');
+  await assert.rejects(decideExpense(db, carol, own.id, 'approved'), { status: 403 });
+});
+
+test('R4: only submitted expenses can be decided, and a decision is final', async () => {
+  const db = await openDb();
+  const draft = await createExpense(db, alice, { amount_cents: 500, description: 'Draft' });
+  await assert.rejects(decideExpense(db, erin, draft.id, 'approved'), { status: 409 });
+  const expense = await submitted(db, alice, 'Meal');
+  await decideExpense(db, carol, expense.id, 'rejected');
+  await assert.rejects(decideExpense(db, carol, expense.id, 'approved'), { status: 409 });
+});
+
+test('R3, R4: the database refuses decisions the server refuses', async () => {
+  const db = await openDb();
+  const raw = (user: User, sql: string, id: number) => asUser(db, user.id, (tx) => tx.query(sql, [id]));
+  const draft = await createExpense(db, alice, { amount_cents: 500, description: 'Draft' });
+  await assert.rejects(raw(alice, `update expenses set status = 'approved' where id = $1`, draft.id));
+  const own = await submitted(db, carol, 'Own');
+  assert.equal((await raw(carol, `update expenses set status = 'approved', decided_by = 3 where id = $1`, own.id)).affectedRows, 0);
+  const decided = await submitted(db, alice, 'Decided');
+  await decideExpense(db, carol, decided.id, 'rejected');
+  assert.equal((await raw(carol, `update expenses set status = 'approved', decided_by = 3 where id = $1`, decided.id)).affectedRows, 0);
+});
+
+test('R5: the queue shows submitted expenses', async () => {
+  const db = await openDb();
+  await submitted(db, alice, 'Books');
+  const queue = await listQueue(db, carol);
+  assert.equal(queue[0]!.description, 'Books');
+  await assert.rejects(listQueue(db, alice), { status: 403 });
+});
