+    and can_see_expense(owner_id, team, status)
+    and exists (select 1 from users u where u.id = current_setting('app.uid')::int and u.role in ('approver', 'admin'))
+  )
+  with check (
+    status in ('approved', 'rejected')
+    and decided_by = current_setting('app.uid')::int
+    and owner_id <> current_setting('app.uid')::int
+    and exists (select 1 from users u where u.id = current_setting('app.uid')::int and u.role in ('approver', 'admin'))
+  );
