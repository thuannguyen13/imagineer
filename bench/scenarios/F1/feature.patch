new file mode 100644
index 0000000..7f04adf
--- /dev/null
+++ b/src/approvals.ts
@@ -0,0 +1,41 @@
+import { asUser, type Db } from './db.ts';
+import { HttpError, type User } from './auth.ts';
+import type { Expense } from './expenses.ts';
+
+export type Decision = 'approved' | 'rejected';
+export type QueueItem = { id: number; owner_name: string; amount_cents: number; description: string; created_at: string };
+
+const columns = 'id, owner_id, team, amount_cents, description, status';
+
+/** Submitted expenses the user may decide; row-level security limits approvers to their team. */
+export async function listQueue(db: Db, user: User): Promise<QueueItem[]> {
+  if (user.role === 'member') throw new HttpError(403, 'Only approvers and admins have an approval queue.');
+  return asUser(db, user.id, async (tx) => {
+    const { rows } = await tx.query<QueueItem>(
+      `select e.id, u.name as owner_name, e.amount_cents, e.description, e.created_at
+         from expenses e join users u on u.id = e.owner_id
+        where e.status = 'submitted' and e.owner_id <> $1
+        order by e.created_at`,
+      [user.id],
+    );
+    return rows;
+  });
+}
+
+/** Approves or rejects a submitted expense. Permission, then record scope, then the rule, under lock. */
+export async function decideExpense(db: Db, user: User, id: number, decision: Decision): Promise<Expense> {
+  if (user.role === 'member') throw new HttpError(403, 'Only approvers and admins can decide expenses.');
+  return db.transaction(async (tx) => {
+    const { rows } = await tx.query<Expense>(`select ${columns} from expenses where id = $1 for update`, [id]);
+    const expense = rows[0];
+    if (!expense) throw new HttpError(404, 'Expense not found.');
+    if (expense.owner_id === user.id) throw new HttpError(403, 'You cannot decide your own expense.');
+    if (expense.status !== 'submitted') throw new HttpError(409, 'Only submitted expenses can be decided.');
+    const updated = await tx.query<Expense>(
+      `update expenses set status = $2, decided_by = $3, decided_at = now()
+        where id = $1 and status = 'submitted' returning ${columns}`,
+      [id, decision, user.id],
+    );
+    return updated.rows[0]!;
+  });
+}
